  "narrative": {
    "northStar": "The Developer Dossier",
    "overview": "An expressive, energetic, rebellious opening menu leads into a readable developer dossier. Persona 5 supplies the structural grammar: overlapping mixed lettering, diagonal planes, irregular selection silhouettes, and Joshua's supplied photographic portrait. Persona 3 Reload informs short fluid responses and information clarity.\n\nSharp backplates, offset borders, sparse halftone, and rotated display plates establish the identity. Upright reading text, explicit development statuses, and accessible selectors keep the work easy to inspect. The confirmed reference-led direction supersedes the earlier conservative split hero.",
    "keyCharacteristics": [
      "One graphic opening scene with an overlapping command menu.",
      "Mixed slab and condensed lettering over red, ink, and paper planes.",
      "Shared accessible selection behavior across case files and equipment.",
      "Calm reading surfaces between expressive graphic moments.",
      "Faithful monochrome portrait cutouts in the hero and tilted profile frame."
    ],
    "rules": [
      {
        "name": "The Selective Cyan Rule",
        "body": "Keep cyan subordinate to red; reserve it for small signals and interaction.",
        "section": "colors"
      },
      {
        "name": "The Upright Reading Rule",
        "body": "Keep paragraphs upright and give technical context ordinary reading leading; rotation and tight leading belong to display composition.",
        "section": "typography"
      },
